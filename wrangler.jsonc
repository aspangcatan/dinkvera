// Cloudflare static-assets deployment (future). Assets-only: no Worker
// script, just the Vite build in ./dist.
{
  "name": "sideline-saas",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // SPA fallback: unknown paths (/manage/rally-point/calendar, ...) get
    // index.html so Vue Router can handle them.
    "not_found_handling": "single-page-application",
  },
}
